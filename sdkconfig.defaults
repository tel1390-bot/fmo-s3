# --- 目标芯片:ESP32-S3(小智面包板 DIY 套件) ---
CONFIG_IDF_TARGET="esp32s3"
# N16R8 模组:16MB Flash + 8MB Octal PSRAM。PSRAM 供 LVGL/大缓冲使用,
# 音频与网络仍走内部 RAM。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- Flash:16MB(N16R8) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 固定 16MB 镜像头,便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 分区表沿用原项目(8MB 布局,recovery 分区保留但无固件、不会被跳转)。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Passport 特有:Bootloader 长按 GPIO0 跳 Recovery 的机制已移除(无 Recovery 固件,
# 防止误触 BOOT 键跳入空白分区),相关 CONFIG_BOOTLOADER_FACTORY_RESET 不设置。

# --- 控制台:USB-Serial-JTAG(S3 原生 USB,GPIO19/20) ---
# S3-DevKitC-1 用 Type-C 数据线即可同时烧录与看日志,不占 UART0(GPIO43/44)。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_FMT_TXT_LARGE=n
# 8MB PSRAM 下此值可保持 24KB(内部 RAM),复杂界面卡死时再调大。
CONFIG_LV_MEM_SIZE_KILOBYTES=24
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# --- Bluetooth LE / NimBLE ---
# FMO 守听屏不使用蓝牙,保持关闭(与 C3 版一致)。
CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n

CONFIG_LV_USE_QRCODE=y
